{
  "name": "decisionactplancodex",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/check-ui.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "playwright test",
    "format:check": "prettier --check src tests scripts server *.ts",
    "start": "node server/start.mjs"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "antd": "6.7.0",
    "dayjs": "1.11.23",
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sirv": "3.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "postcss": "8.5.32",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  },
  "prettier": {
    "singleQuote": true,
    "semi": false
  }
}
